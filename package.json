{
  "name": "github-repo-analyzer",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix frontend run build && npm --prefix server run build",
    "lint": "npm --prefix frontend run lint && npm --prefix server run lint",
    "test": "npm --prefix server run test",
    "typecheck": "npm --prefix frontend run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.13",
    "vite-plugin-node": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "node-fetch": "^2.7.0",
    "rate-limiter-flexible": "^11.2.3",
    "zod": "^4.6.7"
  }
}
